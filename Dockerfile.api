FROM node:20-alpine
WORKDIR /app

# Copy package files first (better layer caching)
COPY package*.json ./
RUN npm ci --only=production

# Copy application files
COPY server.js ./
COPY server-backend.js ./

# Create data directory if needed
RUN mkdir -p /app/data

# Expose port
EXPOSE 5000

# Start server
CMD ["node", "server.js"]
